<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/xui_config_color_background"
    android:orientation="vertical"
    tools:ignore="Overdraw">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/layout_phone_fields"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/forward_only_sim1_phone_label"
                android:textColor="@color/xui_config_color_gray_8"
                android:textSize="@dimen/text_size_large" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_forward_input"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.xuexiang.xui.widget.edittext.ClearEditText
                    android:id="@+id/et_phone_sim1"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@null"
                    android:digits="0123456789"
                    android:hint="@string/sms_forward_phone_sim1_hint"
                    android:inputType="phone"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:singleLine="true" />

                <Button
                    android:id="@+id/btn_save_sim1"
                    android:layout_width="68dp"
                    android:layout_height="38dp"
                    android:layout_marginEnd="5dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:text="@string/save" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/forward_only_sim2_phone_label"
                android:textColor="@color/xui_config_color_gray_8"
                android:textSize="@dimen/text_size_large" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_forward_input"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.xuexiang.xui.widget.edittext.ClearEditText
                    android:id="@+id/et_phone_sim2"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@null"
                    android:digits="0123456789"
                    android:hint="@string/sms_forward_phone_sim2_hint"
                    android:inputType="phone"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:singleLine="true" />

                <Button
                    android:id="@+id/btn_save_sim2"
                    android:layout_width="68dp"
                    android:layout_height="38dp"
                    android:layout_marginEnd="5dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:text="@string/save" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:gravity="center"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_query_user"
                    android:layout_width="104dp"
                    android:layout_height="44dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:text="@string/forward_only_query" />

                <Space
                    android:layout_width="52dp"
                    android:layout_height="1dp" />

                <Button
                    android:id="@+id/btn_reset"
                    android:layout_width="104dp"
                    android:layout_height="44dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:text="@string/reset" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_query_result_sim1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/forward_only_query_result_sim1_empty"
                    android:textColor="@color/xui_config_color_gray_8"
                    android:textSize="@dimen/text_size_medium" />

                <TextView
                    android:id="@+id/tv_query_result_sim2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/forward_only_query_result_sim2_empty"
                    android:textColor="@color/xui_config_color_gray_8"
                    android:textSize="@dimen/text_size_medium" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="@string/forward_only_code_tip"
                android:textColor="@color/red"
                android:textSize="@dimen/text_size_medium" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/forward_only_sim1_label"
                android:textColor="@color/xui_config_color_gray_8"
                android:textSize="@dimen/text_size_large" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_forward_input"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.xuexiang.xui.widget.edittext.ClearEditText
                    android:id="@+id/et_code_sim1"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@null"
                    android:digits="0123456789"
                    android:hint="@string/forward_only_code_hint"
                    android:inputType="number"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:singleLine="true" />

                <Button
                    android:id="@+id/btn_send_code_sim1"
                    android:layout_width="64dp"
                    android:layout_height="38dp"
                    android:layout_marginStart="4dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:text="@string/send" />

                <Button
                    android:id="@+id/btn_clear_code_sim1"
                    android:layout_width="64dp"
                    android:layout_height="38dp"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="5dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:text="@string/clear" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/forward_only_sim2_label"
                android:textColor="@color/xui_config_color_gray_8"
                android:textSize="@dimen/text_size_large" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_forward_input"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.xuexiang.xui.widget.edittext.ClearEditText
                    android:id="@+id/et_code_sim2"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@null"
                    android:digits="0123456789"
                    android:hint="@string/forward_only_code_hint"
                    android:inputType="number"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:singleLine="true" />

                <Button
                    android:id="@+id/btn_send_code_sim2"
                    android:layout_width="64dp"
                    android:layout_height="38dp"
                    android:layout_marginStart="4dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:text="@string/send" />

                <Button
                    android:id="@+id/btn_clear_code_sim2"
                    android:layout_width="64dp"
                    android:layout_height="38dp"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="5dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:text="@string/clear" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
